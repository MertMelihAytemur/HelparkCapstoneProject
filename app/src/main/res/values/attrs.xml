<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="MessageView">
        <attr name="messageType" format="enum">
            <enum name="alert" value="0" />
            <enum name="confirmation" value="1" />
        </attr>
        <attr name="message" format="string" />
    </declare-styleable>

    <declare-styleable name="CustomSearchView">
        <attr name="searchHint" format="string"/>
    </declare-styleable>


    <declare-styleable name="ApEditText">
        <attr name="android:text" format="string"/>
        <attr name="errorText" format="string" />
        <attr name="editTextTitle" format="string" />
        <attr name="hintText" format="string" />
        <attr name="android:maxLength"/>
        <attr name="android:inputType" />
    </declare-styleable>

</resources>




