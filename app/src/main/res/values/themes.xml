<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.HelparkCapstoneProject" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:statusBarColor">@color/light_blue</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="PhoneNumberEditTextStyle" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="android:textColor">@color/text_color_black</item>
        <item name="android:textColorHint">@color/grey</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="fontFamily">@font/montserrat</item>
        <item name="boxStrokeWidthFocused">0dp</item>
    </style>

    <style name="Widget.AppTheme.MaterialButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/color_button_login_text</item>
        <item name="android:textColor">@color/color_button_login_bg</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/montserrat</item>
        <item name="textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">32dp</item>
    </style>
</resources>