<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_otp_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat"
        android:textColor="@color/text_color_black"
        app:layout_constraintStart_toStartOf="@+id/pg_otp"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/otp_second_format" />

    <TextView
        android:id="@+id/tv_otp_again"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:fontFamily="@font/montserrat"
        android:text="@string/resend_code"
        android:textColor="@color/text_color_black"
        app:layout_constraintBottom_toBottomOf="@+id/tv_otp_timer"
        app:layout_constraintEnd_toEndOf="@+id/pg_otp"
        app:layout_constraintTop_toTopOf="@+id/tv_otp_timer" />

    <ProgressBar
        android:id="@+id/pg_otp"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:progress="0"
        android:progressDrawable="@drawable/bg_custom_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_otp_timer" />
</androidx.constraintlayout.widget.ConstraintLayout>