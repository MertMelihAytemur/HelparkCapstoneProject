<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="14dp"
    android:paddingBottom="12dp"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:visibility="visible">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivError"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_error"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/tvErrorTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/montserrat_medium"
        android:gravity="center"
        android:text="@string/car_park_not_found_near"
        android:textColor="@color/a3"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/ivError" />

    <TextView
        android:id="@+id/tvErrorDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/montserrat"
        android:gravity="center"
        android:text="@string/car_park_not_found_desc"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvErrorTitle" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupSampleDistricts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvErrorDescription"
            android:layout_marginTop="6dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSuggestionFirst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:checkable="true"
                android:textSize="11sp"
                android:backgroundTint="#F4EDED"
                android:text="Maltepe"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSuggestionSecond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:textSize="11sp"
                android:backgroundTint="#F4EDED"
                android:fontFamily="@font/montserrat"
                android:text="Beşiktaş"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSuggestionThird"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:textSize="11sp"
                android:fontFamily="@font/montserrat"
                android:backgroundTint="#F4EDED"
                android:text="Üsküdar"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSuggestionFourth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:textSize="11sp"
                android:fontFamily="@font/montserrat"
                android:backgroundTint="@color/bg_chip"
                android:text="Kadıköy"/>

        </com.google.android.material.chip.ChipGroup>

</androidx.constraintlayout.widget.ConstraintLayout>