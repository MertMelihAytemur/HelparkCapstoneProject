<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".features.splash.presentation.SplashFragment">

    <ImageView
        android:id="@+id/ivHelparkLogo"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/helpark_logo"
        android:layout_marginBottom="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tvHelpark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/helpark"
        android:fontFamily="@font/montserrat"
        app:layout_constraintTop_toBottomOf="@id/ivHelparkLogo"
        android:gravity="center"
        android:textSize="24sp"/>


    <TextView
        android:id="@+id/tvVersionNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="v1.0.0"
        android:fontFamily="@font/montserrat"
        android:textColor="@color/purple_700"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:textStyle="normal"
        android:textSize="16sp"/>

</androidx.constraintlayout.widget.ConstraintLayout>